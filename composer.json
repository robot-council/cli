{
    "name": "robot-council/cli",
    "description": "The Robot Council command line: enrollment, the stdio MCP bridge, and an API client",
    "keywords": [
        "robot-council",
        "cli",
        "mcp",
        "laravel-zero"
    ],
    "homepage": "https://github.com/robot-council/cli",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "joshdaugherty",
            "email": "15675878+joshdaugherty@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "laravel/agent-detector": "^2.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "larastan/larastan": "^3.12.1",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^5.2.1",
        "pestphp/pest-plugin-phpstan": "^5.2.1",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "rector/rector": "^2.6.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "test:mutate": "vendor/bin/pest --mutate --path=app",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector",
        "test:refactor": "vendor/bin/rector --dry-run"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "robot-council"
    ]
}
